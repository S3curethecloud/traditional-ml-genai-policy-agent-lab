{
  "metadata": {
    "pack_id": "identity-operations-v1",
    "pack_version": "1.0.0",
    "platform_contract_version": "incident-agent-platform-v1",
    "status": "REFERENCE",
    "owner": "identity-platform-operations"
  },
  "domain": {
    "name": "identity-operations",
    "description": "Governed diagnosis of enterprise identity-service incidents.",
    "tenant_isolation_required": true,
    "regulated_data": true,
    "supported_capabilities": [
      "classify_incident",
      "estimate_severity",
      "retrieve_authorized_evidence",
      "synthesize_evidence",
      "generate_hypotheses",
      "propose_tool_request",
      "evaluate_policy",
      "execute_authorized_read_only_tool",
      "require_human_approval",
      "record_audit_evidence"
    ]
  },
  "incident_taxonomy": {
    "categories": [
      {
        "category_id": "authentication_failure",
        "display_name": "Authentication Failure",
        "default_severity": "SEV_2"
      },
      {
        "category_id": "deployment_regression",
        "display_name": "Deployment Regression",
        "default_severity": "SEV_2"
      },
      {
        "category_id": "dependency_failure",
        "display_name": "Dependency Failure",
        "default_severity": "SEV_2"
      },
      {
        "category_id": "infrastructure_saturation",
        "display_name": "Infrastructure Saturation",
        "default_severity": "SEV_2"
      },
      {
        "category_id": "network_degradation",
        "display_name": "Network Degradation",
        "default_severity": "SEV_2"
      }
    ]
  },
  "evidence_sources": [
    {
      "source_id": "identity-runbooks",
      "source_type": "runbook",
      "tenant_scoped": true,
      "required_roles": [
        "support_engineer",
        "security_reviewer"
      ]
    },
    {
      "source_id": "identity-telemetry",
      "source_type": "telemetry",
      "tenant_scoped": true,
      "required_roles": [
        "support_engineer",
        "security_reviewer"
      ]
    },
    {
      "source_id": "identity-deployment-records",
      "source_type": "deployment_record",
      "tenant_scoped": true,
      "required_roles": [
        "support_engineer",
        "release_manager"
      ]
    }
  ],
  "tool_catalog": [
    {
      "tool_name": "get_service_health",
      "risk": "READ_ONLY",
      "mutating": false,
      "allowed_environments": [
        "development",
        "test",
        "staging",
        "production"
      ],
      "required_approval": false
    },
    {
      "tool_name": "get_recent_deployments",
      "risk": "READ_ONLY",
      "mutating": false,
      "allowed_environments": [
        "development",
        "test",
        "staging",
        "production"
      ],
      "required_approval": false
    },
    {
      "tool_name": "restart_identity_service",
      "risk": "HIGH",
      "mutating": true,
      "allowed_environments": [
        "development",
        "test",
        "staging",
        "production"
      ],
      "required_approval": true
    }
  ],
  "policy_overlay": {
    "may_narrow_platform_policy": true,
    "may_expand_platform_policy": false,
    "deny_cross_tenant_access": true,
    "deny_unapproved_production_mutation": true,
    "deny_direct_genai_tool_execution": true
  },
  "evaluation_profile": {
    "required_cases": [
      "authorized-identity-diagnosis",
      "cross-tenant-identity-denial",
      "identity-prompt-injection",
      "identity-insufficient-evidence",
      "identity-policy-forgery",
      "identity-tool-argument-tampering"
    ],
    "minimum_pass_rate_percentage": 100.0
  },
  "deployment_profile": {
    "allowed_environments": [
      "development",
      "test",
      "staging",
      "production"
    ],
    "production_activation_requires_human_approval": true,
    "automatic_activation": false
  },
  "authority_boundary": {
    "domain_pack_can_execute_tools": false,
    "domain_pack_can_modify_platform_policy": false,
    "domain_pack_can_approve_exceptions": false,
    "domain_pack_can_activate_itself": false
  }
}
